{
    "name": "nexus",
    "type": "module",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "test": "vitest",
        "dev:client": "cd ./packages/client && npm run dev",
        "dev:server": "cd ./packages/server && npm run dev",
        "build:client": "cd ./packages/client && npm run build",
        "build:server": "cd ./packages/server && npm run build",
        "deploy:server": "cd ./packages/server && npm run deploy",
        "deploy": "npm run build:server && npm run build:client && npm run deploy:server"
    },
    "dependencies": {},
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.2.1",
        "globals": "^17.5.0",
        "prettier": "^3.8.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^6.3.5",
        "vitest": "^4.1.5",
        "wrangler": "^4.17.0"
    }
}
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "vars": {
    "ADMIN_USER": "admin",
  },
  "assets": {
    "directory": "./dist/client/",
  },
  "kv_namespaces": [
    {
      "binding": "UPLOAD_KV",
      "id": "6ca9446d60d143eda572f1e3b5c83643",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXUS_FILE_BUCKET", // <~ valid JavaScript variable name
      "bucket_name": "nexus-file",
    },
  ],
  "d1_databases": [
    {
      "binding": "nexus_db",
      "database_name": "nexus-db",
      "database_id": "7dc4cf98-7eba-419e-b0a9-d22b48d55898",
      "migrations_dir": "./drizzle",
    },
  ],
}
